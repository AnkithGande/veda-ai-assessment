# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/veda_ai_assessment?schema=public"

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── JWT (for future auth) ────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-secure-random-string
JWT_EXPIRES_IN=7d
