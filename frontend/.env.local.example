# ─── Frontend Environment Variables ──────────────────────────────────────────
# For local development: copy to .env.local
# For Vercel production: set these in Vercel Dashboard → Settings → Environment Variables

# Backend API base URL
# Local:      http://localhost:4000/api
# Production: https://veda-ai-assessment-2zm7.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Socket.IO server URL
# Local:      http://localhost:4000
# Production: https://veda-ai-assessment-2zm7.onrender.com
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# App
NEXT_PUBLIC_APP_NAME=Veda AI Assessment
