# ─── Frontend Environment Variables (production / Vercel) ────────────────────

# Server-side API URL (used by Next.js server components / SSR)
# No NEXT_PUBLIC_ prefix — available only on the server at runtime
API_URL=https://veda-ai-assessment-2zm7.onrender.com/api

# Client-side API URL (inlined at build time for browser bundles)
NEXT_PUBLIC_API_URL=https://veda-ai-assessment-2zm7.onrender.com/api

# Server-side Socket URL
SOCKET_URL=https://veda-ai-assessment-2zm7.onrender.com

# Client-side Socket URL
NEXT_PUBLIC_SOCKET_URL=https://veda-ai-assessment-2zm7.onrender.com

# App
NEXT_PUBLIC_APP_NAME=Veda AI Assessment
